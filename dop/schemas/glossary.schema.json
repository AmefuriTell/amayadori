{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dop/glossary.schema.json",
  "title": "サービス事典の 1 ページ（P-014）",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "aliases", "reading", "summary", "features", "exam_points", "references", "status", "created"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "ファイル名。例 codedeploy" },
    "name": { "type": "string", "description": "正式な名前（英語）。例 AWS CodeDeploy" },
    "aliases": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "問題の services に出る名前。name も入れる" },
    "reading": { "type": "string", "description": "カタカナの読み（読み上げにも使う）" },
    "summary": { "type": "string", "minLength": 20, "description": "何をするサービスか。日本語 1〜2 文、大学生にわかる言葉で" },
    "features": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": { "type": "object", "additionalProperties": false, "required": ["title", "text", "source_id"],
        "properties": { "title": { "type": "string" }, "text": { "type": "string", "description": "日本語 1〜2 文" }, "source_id": { "type": "string", "pattern": "^S[0-9]+$" } } }
    },
    "exam_points": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": { "type": "object", "additionalProperties": false, "required": ["text", "source_id"],
        "properties": { "text": { "type": "string", "description": "試験で問われやすい点。日本語 1 文" }, "source_id": { "type": "string", "pattern": "^S[0-9]+$" } } }
    },
    "compare": {
      "type": "array", "maxItems": 3,
      "items": { "type": "object", "additionalProperties": false, "required": ["with", "text", "source_id"],
        "properties": { "with": { "type": "string" }, "text": { "type": "string" }, "source_id": { "type": "string", "pattern": "^S[0-9]+$" } } }
    },
    "references": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["url", "source_id", "quote"],
        "properties": {
          "url": { "type": "string", "pattern": "^https://(docs\\.aws\\.amazon\\.com/|aws\\.amazon\\.com/(blogs|about-aws/whats-new|certification)/|d1\\.awsstatic\\.com/)" },
          "source_id": { "type": "string", "pattern": "^S[0-9]+$" },
          "quote": { "type": "string", "maxLength": 200 } } }
    },
    "status": { "enum": ["draft", "verified"] },
    "created": { "type": "string", "format": "date" },
    "last_checked": { "type": "string", "format": "date" },
    "note": { "type": "string" }
  }
}

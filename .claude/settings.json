{
  "permissions": {
    "deny": [
      "Read(./dop/bank/**)",
      "Read(./dop/.loop/state.json)",
      "Read(./dop/.loop/backlog.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/dop/tools/hooks.mjs\" pre-write" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/dop/tools/hooks.mjs\" post-write" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/dop/tools/hooks.mjs\" stop" }]
      }
    ]
  }
}
